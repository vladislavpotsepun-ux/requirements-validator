{
  "name": "requirements-validator",
  "version": "1.2.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "build": "npm run build:web && npm run build:server",
    "build:server": "tsc -p tsconfig.server.json",
    "build:web": "vite build",
    "check": "tsc --noEmit",
    "dev": "node --import tsx src/server.ts --dev",
    "review": "node --import tsx src/cli.ts",
    "start": "node dist/server/server.js",
    "test": "node --import tsx --test test/*.test.ts"
  },
  "dependencies": {
    "@google/genai": "^3.6.1",
    "express": "^5.2.1",
    "pdfjs-dist": "^6.5.438",
    "pdfkit": "0.21.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^22.19.0",
    "@types/pdfkit": "0.17.7",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "tsx": "^4.21.0",
    "typescript": "~5.9.3",
    "vite": "^7.3.8"
  }
}
