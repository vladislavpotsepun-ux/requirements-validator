# Gemini API (required for default gemini provider)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-4-hydrogen

# Model provider: gemini | local | codex
LLM_PROVIDER=gemini

# Local OpenAI-compatible server (loopback only)
LOCAL_BASE_URL=http://127.0.0.1:11434/v1
LOCAL_MODEL=qwen3.5:9b

# Codex CLI model
CODEX_MODEL=gpt-6.2-sol

# Review configuration
REVIEW_MODE=standard
REVIEW_ACCESS_CODE=
AGENT_VERSION=

# Server
HOST=0.0.0.0
PORT=3000
DISABLE_HMR=true
