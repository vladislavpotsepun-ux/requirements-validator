# Доступ к Gemini Developer API
LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-4-hydrogen

# Локальный Ollama или llama.cpp (задайте LLM_PROVIDER=local)
# LOCAL_MODEL=qwen3.5:9b
# LOCAL_BASE_URL=http://127.0.0.1:11434/v1

# Codex CLI с активным сеансом (задайте LLM_PROVIDER=codex)
# CODEX_MODEL=gpt-6.2-sol

# Настройки веб-сервера
# PORT=3000
# HOST=127.0.0.1
# REVIEW_ACCESS_CODE=
# AGENT_VERSION=v1.2.0
